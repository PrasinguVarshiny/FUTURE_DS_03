import pandas as pd
import numpy as np
import requests
import zipfile
import io
import os
import glob
import plotly.graph_objects as go
from plotly.subplots import make_subplots


# ================================================================
# 1. DOWNLOAD DATASET
# ================================================================

url = "https://archive.ics.uci.edu/ml/machine-learning-databases/00222/bank.zip"

response = requests.get(url)

if response.status_code != 200:
    raise Exception("Dataset download failed.")

data_folder = "future_interns_task3_data"

with zipfile.ZipFile(io.BytesIO(response.content)) as z:
    z.extractall(data_folder)


# ================================================================
# 2. FIND bank-full.csv
# ================================================================

csv_files = glob.glob(
    f"{data_folder}/**/*.csv",
    recursive=True
)

bank_file = None

for file in csv_files:
    if os.path.basename(file).lower() == "bank-full.csv":
        bank_file = file
        break

if bank_file is None:
    raise FileNotFoundError("bank-full.csv was not found.")


# ================================================================
# 3. LOAD DATA
# ================================================================

df = pd.read_csv(bank_file, sep=";")

print("Rows:", df.shape[0])
print("Columns:", df.shape[1])


# ================================================================
# 4. DATA CLEANING
# ================================================================

df = df.drop_duplicates().copy()

df["conversion"] = df["y"].map({
    "yes": 1,
    "no": 0
})

df["conversion_status"] = df["y"].map({
    "yes": "Converted",
    "no": "Not Converted"
})


# ================================================================
# 5. AGE GROUPS
# ================================================================

df["age_group"] = pd.cut(
    df["age"],
    bins=[0, 25, 35, 45, 55, 65, 100],
    labels=[
        "18-25",
        "26-35",
        "36-45",
        "46-55",
        "56-65",
        "66+"
    ],
    include_lowest=True
)


# ================================================================
# 6. KPI CALCULATIONS
# ================================================================

total_contacts = len(df)

total_conversions = int(
    df["conversion"].sum()
)

total_dropoffs = (
    total_contacts - total_conversions
)

conversion_rate = (
    total_conversions / total_contacts
) * 100

dropoff_rate = (
    total_dropoffs / total_contacts
) * 100


# ================================================================
# 7. ANALYSIS DATA
# ================================================================

# Contact Channel
channel_data = (
    df.groupby("contact")["conversion"]
    .mean()
    .mul(100)
    .sort_values(ascending=False)
)


# Age Group
age_data = (
    df.groupby(
        "age_group",
        observed=True
    )["conversion"]
    .mean()
    .mul(100)
)


# Job
job_data = (
    df.groupby("job")["conversion"]
    .mean()
    .mul(100)
    .sort_values(ascending=True)
)


# Education
education_data = (
    df.groupby("education")["conversion"]
    .mean()
    .mul(100)
    .sort_values(ascending=False)
)


# Month
month_order = [
    "jan",
    "feb",
    "mar",
    "apr",
    "may",
    "jun",
    "jul",
    "aug",
    "sep",
    "oct",
    "nov",
    "dec"
]

month_data = (
    df.groupby("month")["conversion"]
    .mean()
    .mul(100)
    .reindex(month_order)
)


# Previous Campaign
previous_data = (
    df.groupby("poutcome")["conversion"]
    .mean()
    .mul(100)
    .sort_values(ascending=False)
)


